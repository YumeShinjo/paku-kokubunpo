rules_version = '2';

// ランキング(SPEC 8章)のセキュリティルール。
//
// データの形: classes/{クラスコード}/members/{匿名認証のuid} = { nickname, score, updatedAt, icon(あってもなくてもよい) }
//  - クラスの一覧は取れない(/classes/{classCode} 自体にはルールがなく、拒否される)。
//    クラスコード(合言葉)を知っている人だけが、そのクラスの members を読める。
//  - 書き込み・削除は、自分のドキュメント(ドキュメントIDが自分のuid)だけ。他人のデータは変更できない。
//  - 得点は「減らせない」「上限200000」。増え方にも上限がある(不正対策。値は src/features/ranking/scoreLimits.ts と同じにする):
//      * 新しく作るときの得点は 5000 まで
//      * 更新1回で増やせるのは、10 + 8点/秒 × (前回の更新からの経過秒数)、かつ 20000 まで
//    (得点はアプリが計算して送るので、悪意のある端末が自分の得点を、この上限の範囲で盛ることまでは防げない。
//     答えあわせをサーバーで行う仕組み(Cloud Functions=有料プラン)がないため。
//     防いでいるのは、他人のデータの書き換え・削除と、桁外れの値・急激な増え方・形式の崩れ。)
//  - 読み取りはログイン(匿名認証)済みのときだけ。
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classCode}/members/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // 形式: nickname(文字列・1〜48。アプリ側は12文字まで)/ score(0〜200000の整数)/ updatedAt(サーバー時刻)/
      //       icon(主人公のアイコンの id。文字列・1〜32。古い版が書いたデータには無い)
      function validShape(data) {
        return data.keys().hasOnly(['nickname', 'score', 'updatedAt', 'icon'])
          && data.keys().hasAll(['nickname', 'score', 'updatedAt'])
          && (!('icon' in data) || (data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 32))
          && data.nickname is string
          && data.nickname.size() >= 1
          && data.nickname.size() <= 48
          && data.score is int
          && data.score >= 0
          && data.score <= 200000
          && data.updatedAt == request.time;
      }

      allow read: if request.auth != null;

      allow create: if isOwner()
        && classCode.size() >= 1
        && classCode.size() <= 80
        && validShape(request.resource.data)
        && request.resource.data.score <= 5000;

      allow update: if isOwner()
        && validShape(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 20000
        // 増え方の上限: 増えた点数 × 1000 <= 10 × 1000 + 経過ミリ秒 × 8(点/秒)
        && (request.resource.data.score - resource.data.score) * 1000
           <= 10 * 1000 + (request.time.toMillis() - resource.data.updatedAt.toMillis()) * 8;

      allow delete: if isOwner();
    }
  }
}
