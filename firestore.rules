rules_version = '2';

// ランキング(SPEC 8章)のセキュリティルール。
//
// データの形: classes/{クラスコード}/members/{匿名認証のuid} = { nickname, score, updatedAt }
//  - クラスの一覧は取れない(/classes/{classCode} 自体にはルールがなく、拒否される)。
//    クラスコード(合言葉)を知っている人だけが、そのクラスの members を読める。
//  - 書き込み・削除は、自分のドキュメント(ドキュメントIDが自分のuid)だけ。他人のデータは変更できない。
//  - 得点は「減らせない」「1回の更新で増やせるのは20000まで」「上限200000」。
//    (得点はアプリが計算して送るので、悪意のある端末が自分の得点を盛ることまでは防げない。
//     防いでいるのは、他人のデータの書き換え・削除と、桁外れの値・形式の崩れ。)
//  - 読み取りはログイン(匿名認証)済みのときだけ。
service cloud.firestore {
  match /databases/{database}/documents {
    match /classes/{classCode}/members/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // 形式: nickname(文字列・1〜48。アプリ側は12文字まで)/ score(0〜200000の整数)/ updatedAt(サーバー時刻)
      function validShape(data) {
        return data.keys().hasOnly(['nickname', 'score', 'updatedAt'])
          && data.keys().hasAll(['nickname', 'score', 'updatedAt'])
          && data.nickname is string
          && data.nickname.size() >= 1
          && data.nickname.size() <= 48
          && data.score is int
          && data.score >= 0
          && data.score <= 200000
          && data.updatedAt == request.time;
      }

      allow read: if request.auth != null;

      allow create: if isOwner()
        && classCode.size() >= 1
        && classCode.size() <= 80
        && validShape(request.resource.data);

      allow update: if isOwner()
        && validShape(request.resource.data)
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 20000;

      allow delete: if isOwner();
    }
  }
}
